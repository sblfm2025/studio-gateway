# RadioBOSS Remote Control API
RADIOBOSS_API_URL=http://127.0.0.1:9001
RADIOBOSS_API_PASSWORD=GANTI_PASSWORD_RADIOBOSS

# Firebase Admin SDK
FIREBASE_PROJECT_ID=radiosbl-project
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gateway identity
GATEWAY_ID=studio-main
GATEWAY_NAME=Studio Utama Radio SBL
PC_NAME=STUDIO-SBL

# Polling
POLL_INTERVAL_SECONDS=30
RADIOBOSS_TIMEOUT_MS=5000
FIRESTORE_OP_TIMEOUT_MS=15000
FIRESTORE_QUOTA_COOLDOWN_SECONDS=300
NOW_PLAYING_MIN_WRITE_SECONDS=10
STATUS_MIN_WRITE_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60
ERROR_AUDIT_MIN_SECONDS=300
COMMAND_WORKER_ENABLED=true
COMMAND_POLL_INTERVAL_SECONDS=30
AUTO_RECORDING_ENABLED=false
AUTO_RECORDING_INTERVAL_SECONDS=120
SCHEDULE_CACHE_TTL_SECONDS=120
ATTENDANCE_CACHE_TTL_SECONDS=60
SONG_REQUEST_WORKER_ENABLED=true
SONG_REQUEST_WORKER_INTERVAL_SECONDS=120
SONG_REQUEST_AUTO_FORWARD_TO_RADIOBOSS=true
SONG_REQUEST_DUMMY_FILE_PATH=E:\_SBL_REQUEST_NOTE.mp3

# WhatsApp Request Worker
WHATSAPP_REQUEST_WORKER_ENABLED=false
WHATSAPP_WORKER_START_DELAY_SECONDS=60
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_MAX_REQUEST_PER_PHONE_PER_HOUR=3
WHATSAPP_SESSION_DIR=./wa-session
WHATSAPP_REQUIRE_KEYWORD=true
WHATSAPP_ALLOWED_KEYWORDS=req,request,lagu,putarkan,minta lagu,kirim lagu

# Recording and library safe roots
RADIO_SBL_RECORDING_ROOT=D:\RadioSBL_REKAMAN
RADIO_SBL_MUSIC_LIBRARY_ROOT=D:\RadioSBL_AUDIO

# Mock/testing
MOCK_FIREBASE=false
MOCK_RADIOBOSS=false

# Logging
LOG_FILE=./gateway.log
LOG_MAX_SIZE_MB=5
