# RadioBOSS Remote Control API
RADIOBOSS_API_URL=http://127.0.0.1:9001
RADIOBOSS_API_PASSWORD=GANTI_PASSWORD_RADIOBOSS

# Firebase Admin SDK
FIREBASE_PROJECT_ID=radiosbl-project
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional Firebase Admin SDK khusus metadata recording
# Isi jika programRecordings dan programRecordingRules ingin dipisah ke project recording.
RECORDING_FIREBASE_PROJECT_ID=
RECORDING_GOOGLE_APPLICATION_CREDENTIALS=./service-account-recording.json

# Multi-project Firestore:
# - FIREBASE_PROJECT_ID = data operasional aplikasi RadioSBL
# - FIREBASE_GATEWAY_PROJECT_ID = RadioBOSS gateway/request/now playing/status/commands
# - RECORDING_FIREBASE_PROJECT_ID = programRecordings dan programRecordingRules
FIREBASE_MULTI_PROJECT_ENABLED=false
FIREBASE_ALLOW_CLIENT_SDK_WRITES=false
FIREBASE_GATEWAY_PROJECT_ID=
FIREBASE_GATEWAY_GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_REQUEST_PROJECT_ID=
FIREBASE_REQUEST_GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_OVERLAY_API_KEY=
FIREBASE_OVERLAY_AUTH_DOMAIN=
FIREBASE_OVERLAY_PROJECT_ID=
FIREBASE_OVERLAY_STORAGE_BUCKET=
FIREBASE_OVERLAY_MESSAGING_SENDER_ID=
FIREBASE_OVERLAY_APP_ID=
FIREBASE_OVERLAY_GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_OVERLAY2_API_KEY=
FIREBASE_OVERLAY2_AUTH_DOMAIN=
FIREBASE_OVERLAY2_PROJECT_ID=
FIREBASE_OVERLAY2_STORAGE_BUCKET=
FIREBASE_OVERLAY2_MESSAGING_SENDER_ID=
FIREBASE_OVERLAY2_APP_ID=
FIREBASE_OVERLAY2_GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_ROUTE_GATEWAY=overlay
FIRESTORE_ROUTE_RECORDING=overlay2

# Gateway identity
GATEWAY_ID=studio-main
GATEWAY_NAME=Studio Utama Radio SBL
PC_NAME=STUDIO-SBL

# Polling
POLL_INTERVAL_SECONDS=60
RADIOBOSS_TIMEOUT_MS=5000
FIRESTORE_OP_TIMEOUT_MS=15000
FIRESTORE_RETRY_ATTEMPTS=0
FIRESTORE_RETRY_DELAY_MS=2000
FIRESTORE_QUOTA_COOLDOWN_SECONDS=900
NOW_PLAYING_MIN_WRITE_SECONDS=60
STATUS_MIN_WRITE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=120
ERROR_AUDIT_MIN_SECONDS=300
COMMAND_WORKER_ENABLED=false
COMMAND_POLL_INTERVAL_SECONDS=120
AUTO_RECORDING_ENABLED=false
AUTO_RECORDING_INTERVAL_SECONDS=300
SCHEDULE_CACHE_TTL_SECONDS=120
ATTENDANCE_CACHE_TTL_SECONDS=60
SONG_REQUEST_WORKER_ENABLED=false
SONG_REQUEST_WORKER_INTERVAL_SECONDS=300
SONG_REQUEST_AUTO_FORWARD_TO_RADIOBOSS=false
SONG_REQUEST_DUMMY_FILE_PATH=E:\_SBL_REQUEST_NOTE.mp3

# WhatsApp Request Worker
WHATSAPP_REQUEST_WORKER_ENABLED=false
WHATSAPP_WORKER_START_DELAY_SECONDS=60
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_MAX_REQUEST_PER_PHONE_PER_HOUR=3
WHATSAPP_SESSION_DIR=./wa-session
WHATSAPP_REQUIRE_KEYWORD=true
WHATSAPP_ALLOWED_KEYWORDS=req,request,lagu,putarkan,minta lagu,kirim lagu

# Recording and library safe roots
RADIO_SBL_RECORDING_ROOT=D:\RadioSBL_REKAMAN
RADIO_SBL_MUSIC_LIBRARY_ROOT=D:\RadioSBL_AUDIO

# Mock/testing
MOCK_FIREBASE=false
MOCK_RADIOBOSS=false

# Logging
LOG_FILE=./gateway.log
LOG_MAX_SIZE_MB=5
